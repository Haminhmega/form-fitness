{
  "name": "form-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/clean-build.mjs && tsc -b && vite build && node scripts/build-pwa.mjs && node scripts/build-server.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "prepare:ai": "node scripts/prepare-ai.mjs",
    "generate:ai-profiles": "node scripts/generate-popular-ai.mjs",
    "test:ai": "node scripts/test-squat.mjs && node scripts/test-generic-ai.mjs && node scripts/test-specific-ai.mjs && node scripts/test-priority-ai.mjs && node scripts/test-form-feedback.mjs && node scripts/test-squat-coaching.mjs",
    "test:workout": "node scripts/test-workout.mjs",
    "test:camera": "node scripts/test-camera-recording.mjs",
    "test:catalog": "node scripts/test-catalog.mjs",
    "test:coaching": "node scripts/test-coaching.mjs && node scripts/test-training-duration.mjs && node scripts/test-coaching-storage.mjs",
    "test:measurements": "node scripts/test-measurements.mjs",
    "test:anatomy": "node scripts/test-anatomy.mjs",
    "test:recovery": "node scripts/test-recovery.mjs",
    "test:account-recovery": "node scripts/test-account-recovery.mjs",
    "test:ui": "node scripts/smoke-review-update.mjs",
    "db:generate": "drizzle-kit generate",
    "preview:server": "wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --port 8787",
    "test:accounts": "node scripts/test-accounts.mjs && node scripts/test-email-security.mjs && node scripts/test-usage.mjs",
    "test:rewards": "node scripts/test-rewards.mjs",
    "test:rewards-ui": "node scripts/test-rewards-ui.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@noble/hashes": "2.4.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.92.0"
  }
}
